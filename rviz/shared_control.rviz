# RViz config for sc_ros_empathic. On /sc_ros_empathic/viz: the circle
# to trace (outline + disc), the EE + its trail, the v_h/v_r/v_s arrows
# and the eta text. Plus the human arm as the visuo-tactile pipeline
# publishes it (/skeleton_3d/keypoints, /skeleton_3d/connectors,
# /right_arm_description -- topic names are lower-case "3d"). The FR3
# model is included but DISABLED (it
# hides the task); enable it in the Displays panel if you want it.
# Fixed Frame base_link. Default view: top-down orthographic on the
# circle plane (centred on the task); a 3D orbit that also frames the
# FR3 and the human is saved in the Views panel.
Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MarkerArray1
      Splitter Ratio: 0.5
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.2
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: false
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: false
      Name: Franka FR3 Model
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: false
      Visual Enabled: true
    - Class: rviz/Group
      Name: skeleton_3d
      Enabled: true
      Displays:
        - Class: rviz/Marker
          Name: connectors
          Enabled: true
          Marker Topic: /skeleton_3d/connectors
          Queue Size: 100
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds: {Max Value: 10, Min Value: -10, Value: true}
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud
          Color: 0; 230; 230
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: keypoints
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.03
          Style: Spheres
          Topic: /skeleton_3d/keypoints
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
      Value: true
    - Class: rviz/Group
      Name: human_description
      Enabled: true
      Displays:
        - Alpha: 0.8
          Class: rviz/RobotModel
          Collision Enabled: false
          Enabled: true
          Name: Right Arm URDF
          Robot Description: /right_arm_description
          TF Prefix: ""
          Update Interval: 0
          Value: true
          Visual Enabled: true
      Value: true
    - Class: rviz/MarkerArray
      Name: MarkerArray
      Enabled: true
      Marker Topic: /sc_ros_empathic/viz
      Queue Size: 10
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top-down (circle plane)
      Target Frame: <Fixed Frame>
      X: 0.45
      Y: 0.0
      Scale: 1400
      Angle: 1.5708
      Invert Z Axis: false
      Near Clip Distance: 0.01
    Saved:
      - Class: rviz/Orbit
        Name: Scene (circle + FR3 + human)
        Distance: 2.6
        Focal Point: {X: 0.5, Y: 0.3, Z: 0.45}
        Pitch: 0.65
        Yaw: 0.9
        Near Clip Distance: 0.01
  Value: true
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Width: 1200
  Hide Left Dock: false
  Hide Right Dock: false
