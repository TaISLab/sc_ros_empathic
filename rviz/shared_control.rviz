# RViz config for sc_ros_empathic: the circle to trace (outline + disc),
# the end-effector + its trail, the v_h/v_r/v_s arrows and the eta text
# (all on /sc_ros_empathic/viz), the FR3 model, and the human arm as the
# visuo-tactile pipeline already publishes it (/skeleton_3D/connectors,
# /skeleton_3D/keypoints, /right_arm_description). Fixed Frame base_link.
# Default view is TopDownOrtho on the circle plane; a 3D Orbit is saved.
# Loaded by the launch:  rviz -d $(find sc_ros_empathic)/rviz/shared_control.rviz
Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MarkerArray1
      Splitter Ratio: 0.5
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
    - Class: rviz/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.3
      Show Arrows: false
      Show Axes: true
      Show Names: false
    - Class: rviz/RobotModel
      Name: FR3
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/RobotModel
      Name: Right Arm URDF
      Enabled: true
      Robot Description: /right_arm_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 0.8
    - Class: rviz/Marker
      Name: skeleton connectors
      Enabled: true
      Marker Topic: /skeleton_3D/connectors
      Queue Size: 100
    - Class: rviz/PointCloud
      Name: skeleton keypoints
      Enabled: true
      Topic: /skeleton_3D/keypoints
      Style: Spheres
      Size (m): 0.03
      Color: 0; 230; 230
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Use Fixed Frame: true
      Queue Size: 10
    - Class: rviz/MarkerArray
      Name: MarkerArray
      Enabled: true
      Marker Topic: /sc_ros_empathic/viz
      Queue Size: 10
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top-down (circle plane)
      Target Frame: <Fixed Frame>
      X: 0.45
      Y: 0.0
      Scale: 1400
      Angle: 1.5708            # rotate so robot +X points DOWN on screen
      Invert Z Axis: false
      Near Clip Distance: 0.01
    Saved:
      - Class: rviz/Orbit
        Name: 3D Orbit
        Distance: 1.2
        Focal Point:
          X: 0.45
          Y: 0.0
          Z: 0.45
        Pitch: 0.6
        Yaw: 0.9
        Near Clip Distance: 0.01
  Value: true
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Width: 1200
  Hide Left Dock: false
  Hide Right Dock: false
