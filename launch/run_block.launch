<?xml version="1.0"?>
<!--
  run_block.launch  -  one condition block, end to end.
  Package: sc_effort_experiment

      roslaunch sc_effort_experiment run_block.launch subject:=S01 condition:=2

  condition:  0 = compliant baseline        (Gamma = I)
              2 = anisotropic accumulated    (proposed)
              3 = isotropic matched          (control for directionality)
              1 = instantaneous ablation     (kept, but normally NOT run as a
                  block: that contrast is now done offline from any log)

  The decisive contrast is 2 vs 3: same mean attenuation, with and without
  directional structure. Condition 0 only shows that Gamma does something;
  condition 3 shows whether its DIRECTION is what does it.

  There is NOTHING to wire here: every node reads the same subjects/SXX.yaml
  through subject_config.py. If a value is missing the node aborts with a
  clear message rather than running with a silent default.

  Session order:
    1. setup + anthropometry     -> fill subjects/SXX.yaml by hand
    2. MVC with the luggage scale-> fill the mvc block by hand
    3. rosrun sc_effort_experiment compute_subject_params.py subjects/SXX.yaml
       (fills the derived block, prints GO / NO-GO)
    4. this launch three times, counterbalanced, 5 min rest between blocks
    5. Borg RPE after each block -> record in the yaml

  Start:  rostopic pub -1 /sc_effort_experiment/start std_msgs/Bool "data: true"
  Abort:  rostopic pub -1 /sc_effort_experiment/abort std_msgs/Bool "data: true"
-->
<launch>

  <arg name="subject"   default="S01"/>
  <arg name="condition" default="2"/>
  <arg name="subject_file"
       default="$(find sc_effort_experiment)/scripts/subjects/$(arg subject).yaml"/>
  <!-- Package root, not $HOME: keeps logs alongside the code, portable
       across machines/users and easy to include in the repo's .gitignore. -->
  <arg name="logdir" default="$(find sc_effort_experiment)/sc_logs"/>

  <arg name="robot_ip" default="172.16.0.2"/>
  <arg name="arm_id"   default="fr3"/>

  <!-- Topic on which the visuo-tactile estimator publishes the 4-DoF human arm
       configuration. CHECK THIS NAME with `rostopic hz` BEFORE EVERY SESSION.
       If it is wrong the fatigue node does not fail loudly: it holds Gamma at
       identity on the staleness timeout and the block runs silently as a
       baseline. That is the most expensive mistake available here. -->
  <arg name="arm_state_topic" default="/right_arm/joint_states"/>

  <!-- ================= robot bring-up ================= -->
  <!-- Placed first so the controller is up before anything subscribes to
       franka_states or publishes velocity commands. No artificial delay is
       needed: sc_fatigue_node, lane_admittance_controller and the
       orchestrator all wait for the first robot state before doing anything,
       and the fatigue node holds Gamma at identity meanwhile. -->
  <include file="$(find taislab_franka_controllers)/launch/cartesian_velocity_external_controller.launch">
    <arg name="robot_ip"     value="$(arg robot_ip)"/>
    <arg name="load_gripper" value="false"/>
  </include>

  <!-- ================= fatigue / Gamma ================= -->
  <node pkg="sc_effort_experiment" type="sc_fatigue_node.py"
        name="sc_fatigue_node" output="screen">
    <param name="subject_file"    value="$(arg subject_file)"/>
    <param name="condition"       value="$(arg condition)"/>
    <param name="mode"            value="run"/>
    <param name="rate"            value="100.0"/>
    <param name="logdir"          value="$(arg logdir)"/>
    <param name="arm_state_topic" value="$(arg arm_state_topic)"/>
    <!-- Pose older than this disables modulation. Raise it if your estimator
         runs slower than ~5 Hz, but be aware that Gamma then acts on an
         increasingly out-of-date arm configuration. -->
    <param name="max_pose_age"    value="0.2"/>
  </node>

  <!-- ================= admittance + Gamma ================= -->
  <node pkg="sc_effort_experiment" type="lane_admittance_controller.py"
        name="lane_admittance_controller" output="screen">
    <param name="subject_file" value="$(arg subject_file)"/>
  </node>

  <!-- ================= task + phase state machine ================= -->
  <node pkg="sc_effort_experiment" type="sc_experiment_orchestrator.py"
        name="sc_experiment_orchestrator" output="screen">
    <param name="subject_file" value="$(arg subject_file)"/>
    <param name="condition"    value="$(arg condition)"/>
    <param name="logdir"       value="$(arg logdir)"/>
    <param name="familiar_s"   value="10.0"/>
    <param name="y_span"       value="0.22"/>
    <param name="target_tol"   value="0.05"/>
  </node>

  <!-- ================= visualisation ================= -->
  <!-- Native 2D Y-Z plot instead of RViz: the task only scores (y, z), so
       this shows exactly what is being measured, with no perspective/TF
       dependency. -->
  <arg name="viewer" default="true"/>
  <node if="$(arg viewer)" pkg="sc_effort_experiment"
        type="sc_experiment_viewer2d.py" name="sc_experiment_viewer2d"
        output="screen">
    <param name="subject_file" value="$(arg subject_file)"/>
    <param name="y_span"       value="0.22"/>
    <param name="target_tol"   value="0.05"/>
  </node>

  <!-- ================= record everything ================= -->
  <node pkg="rosbag" type="record" name="rosbag_record"
        args="-O $(arg logdir)/$(arg subject)_cond$(arg condition).bag
              /franka_state_controller/franka_states
              $(arg arm_state_topic)
              /sc_effort_experiment/gamma
              /sc_effort_experiment/phi_shoulder
              /sc_effort_experiment/phi_elbow
              /sc_effort_experiment/phase
              /sc_effort_experiment/target
              /sc_effort_experiment/dwell
              /robot_vel_ctrl/vel_cmd"/>

</launch>
