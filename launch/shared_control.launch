<?xml version="1.0"?>
<!--
  shared_control.launch  -  reactive, performance-weighted shared
  control (human joint-limit safety + robot manipulability factors)
  on the FR3, end to end, wired for the human-subject protocol
  (paper Sec. V).

  Minimal run (proposed controller, nominal placement):

      roslaunch sc_ros_empathic shared_control.launch

  Select the experimental condition (paper Sec. V-B):

      roslaunch sc_ros_empathic shared_control.launch condition:=B_baseline_m2
      condition := A_standalone | B_baseline_m2 | C_jointsafety_m3
                 | D_manip_m3   | E_extended_m4
      (F, the impedance-control AAN baseline of Zhang et al. [9], is a
       DIFFERENT controller: roslaunch sc_ros_empathic baseline_aan.launch)

  Select the workspace placement (paper Sec. V-A). Nominal replicates
  [1]'s mid-workspace circle; stressed pushes it toward the edge of the
  combined human/robot reach. The stressed centre is PER-PARTICIPANT
  (computed from the visuo-tactile l1,l2 + shoulder calibration); the
  value below is only a template:

      roslaunch sc_ros_empathic shared_control.launch \
          placement:=stressed \
          path_center:="[0.62, 0.05, 0.30]"

  Record a trial to a bag (topics needed for the Sec. V-D metrics):

      roslaunch sc_ros_empathic shared_control.launch \
          condition:=E_extended_m4 record:=true trial_label:=P03_stressed_E

  CHECK BEFORE EVERY SESSION:
    - human_joint_state_topic / human_link_lengths_topic: PLACEHOLDERS,
      pending confirmation from the visuo-tactile pipeline owner. If
      wrong, shared_control_node does NOT fail loudly: it logs one
      warning and runs without the joint_safety factor. `rostopic hz`
      both topics before trusting a session.
    - base_link/ee_link: must match the link names in the FR3 URDF
      actually loaded on /robot_description (fr3_link0/fr3_link8 here;
      rename if your description uses different names, e.g. panda_*).
    - config/shared_control.yaml holds PLACEHOLDER (pre-hardware) gains.
-->
<launch>

  <arg name="robot_ip" default="172.16.0.2"/>
  <arg name="base_link" default="fr3_link0"/>
  <arg name="ee_link"   default="fr3_link8"/>

  <!-- Experimental condition (paper Sec. V-B). No default fall-through
       in the node: an unknown id aborts startup with the valid list. -->
  <arg name="condition" default="E_extended_m4"/>

  <!-- Placement label, for logging / bag naming only; the geometry is
       set by path_center/path_radius/path_normal below. -->
  <arg name="placement" default="nominal"/>

  <!-- Per-volunteer config: config/subjects/<subject>.yaml, holding
       ONLY the volunteer's id, arm segment lengths and pre-registered
       joint ranges. Empty -> node runs from plain params. -->
  <arg name="subject" default=""/>
  <arg name="subject_file"
       default="$(eval find('sc_ros_empathic') + '/config/subjects/' + subject + '.yaml' if subject else '')"/>

  <arg name="human_joint_state_topic"  default="/right_arm/joint_states"/>
  <arg name="human_link_lengths_topic" default="/right_arm/link_lengths"/>
  <!-- shoulder/elbow/wrist Cartesian points in the pipeline's fixed
       frame (PLACEHOLDER name/type; Float64MultiArray [sx..sz,ex..ez,wx..wz]). -->
  <arg name="human_arm_points_topic"   default="/right_arm/arm_points"/>
  <arg name="human_points_frame"       default="fr3_link0"/>

  <!-- Robot Jacobian for the manipulability factor. 'analytic'
       (default): pure-numpy FR3 FK + Jacobian from q (fr3_model.py),
       self-contained, no PyKDL, per-candidate lookahead. 'kdl': same
       via PyKDL + /robot_description. 'topic': a 6xN Jacobian published
       elsewhere as std_msgs/Float64MultiArray row-major (PLACEHOLDER
       name). 'none': disable the factor. -->
  <arg name="jacobian_source"      default="analytic"/>
  <arg name="robot_jacobian_topic" default="/taislab_controller/jacobian"/>

  <!-- Nominal placement (replicates [1]). Override path_center for the
       per-participant stressed placement. -->
  <arg name="path_center" default="[0.45, 0.0, 0.45]"/>
  <arg name="path_radius" default="0.05"/>
  <arg name="path_normal" default="[0.0, 0.0, 1.0]"/>
  <arg name="path_direction" default="forward"/>  <!-- forward | reverse -->


  <!-- Loop-tuning knobs, exposed so you can iterate without editing
       config/shared_control.yaml. Conservative starting values: raise
       once the loop is confirmed stable on this robot. -->
  <arg name="Ka"                 default="1.0"/>   <!-- path-following P gain (1/s); was 2.0 -->
  <arg name="rho_min"            default="0.02"/>  <!-- pure-pursuit lookahead on the path [m] -->
  <arg name="cruise_speed"       default="0.03"/>  <!-- tangential feed-forward around the circle [m/s] -->
  <arg name="follower_mode"     default="crosstrack"/>  <!-- crosstrack (tracks the reference radius) | lookahead ([1] law, cuts corners under lag) -->
  <arg name="v_max"              default="0.08"/>  <!-- EE speed cap [m/s] -->
  <arg name="lpf_alpha"          default="0.15"/>  <!-- command LPF (smaller = smoother) -->
  <arg name="admittance_mass"    default="[2.0, 2.0, 2.0]"/>
  <arg name="admittance_damping" default="[40.0, 40.0, 40.0]"/>
  <arg name="force_deadzone_N"   default="2.0"/>

  <arg name="rate_hz"    default="200.0"/>
  <arg name="rviz"       default="true"/>
  <arg name="show_plane" default="true"/>   <!-- fill the circle with a translucent disc in RViz -->
  <arg name="show_vel_arrows" default="true"/>  <!-- v_h/v_r/v_s as arrows at the EE -->
  <arg name="show_eta_text"   default="true"/>  <!-- eta_h/eta_r/eta_s as floating text -->
  <arg name="vel_arrow_gain"  default="2.0"/>   <!-- metres of arrow per m/s -->
  <arg name="show_arm"    default="true"/>   <!-- human arm polyline in RViz -->
  <arg name="show_arm_fk" default="false"/>  <!-- also overlay the FK arm -->
  <!-- Human shoulder/elbow/wrist keypoints for the RViz polyline.
       source 'topic': keypoints in human_arm_topic, message type
       human_arm_msg_type (imported by name at runtime; the point for
       each human_arm_keys name is found reflectively). source 'tf':
       origins of human_arm_frames. -->
  <arg name="human_arm_source"   default="topic"/>       <!-- topic | tf -->
  <arg name="human_arm_topic"    default="/right_arm/kp_URDF"/>
  <arg name="human_arm_msg_type" default="upper_limb_kinematics/KP_URDF"/>
  <arg name="human_arm_keys"     default="[right_shoulder, right_elbow, right_wrist]"/>
  <arg name="human_arm_frames"   default="[]"/>          <!-- source:=tf -->
  <!-- Shoulder frame ~diag/arm_points_fk is published in (source:=tf). -->
  <arg name="human_shoulder_frame" default="base_shoulder"/>
  <arg name="rviz_config" default="$(find sc_ros_empathic)/rviz/shared_control.rviz"/>

  <!-- Gains / weights / model params (PLACEHOLDER values, see file). -->
  <arg name="config" default="$(find sc_ros_empathic)/config/shared_control.yaml"/>

  <!-- Trial ends after this many laps (0 = run until Ctrl-C). The
       paper's trial is 4 loops (first = training).
       trial_end := shutdown (default) -> the node exits and, because it
       is required="true", roslaunch tears the whole launch down (RViz +
       rosbag), closing the bag/CSV cleanly. 'hold' -> the node stays
       alive at zero velocity and you Ctrl-C when ready. -->
  <arg name="trial_laps" default="0"/>
  <arg name="trial_end"  default="shutdown"/>
  <!-- C/E only: if true, hold zero velocity while joint_safety has no
       fresh q_h + l1,l2 (so an invalid trial cannot be recorded). -->
  <arg name="require_fresh_human" default="false"/>

  <!-- Bag / CSV basename: <subject>_<condition> when subject:= is
       given, else just <condition>. Both the rosbag ('-o') and the CSV
       append _<YYYY-MM-DD-HH-MM-SS>. Override explicitly if needed. -->
  <arg name="trial_label" default="$(eval (subject + '_' + condition) if subject else condition)"/>

  <!-- Bag recording of the trial. -->
  <arg name="record"      default="false"/>
  <arg name="bag_dir"     default="$(env HOME)/sc_ros_empathic_bags"/>

  <!-- Plain-CSV log (one row per cycle), analysis without the bag.
       csv:=true -> <csv_dir>/<trial_label>_<YYYY-MM-DD_HH-MM-SS>.csv.
       csv_path:= gives an exact file instead. -->
  <arg name="csv"      default="false"/>
  <arg name="csv_dir"  default="$(env HOME)/sc_ros_empathic_logs"/>
  <arg name="csv_path" default=""/>

  <!-- ================= robot bring-up (OPT-IN) ================= -->
  <!-- OFF by default: in this lab the FR3 bring-up + the external
       Cartesian velocity controller are launched separately (e.g. from
       the perception/control PC). This node only needs
       franka_state_controller and a controller listening on
       ~cmd_topic to be already up. Set robot_bringup:=true only on a
       standalone setup where nothing else starts them. -->
  <arg name="robot_bringup" default="false"/>
  <include if="$(arg robot_bringup)"
           file="$(find taislab_franka_controllers)/launch/cartesian_velocity_external_controller.launch">
    <arg name="robot_ip"     value="$(arg robot_ip)"/>
    <arg name="load_gripper" value="false"/>
  </include>

  <!-- ================= shared control ================= -->
  <!-- required: its exit (Ctrl-C, crash, or trial_end:=shutdown after
       trial_laps) brings down RViz + the rosbag too. -->
  <node pkg="sc_ros_empathic" type="shared_control_node.py"
        name="shared_control_node" output="screen" required="true">
    <!-- Gains/weights first, so explicit params below win over the file. -->
    <rosparam command="load" file="$(arg config)"/>

    <param name="condition" value="$(arg condition)"/>
    <param name="trial_end" value="$(arg trial_end)"/>
    <param name="subject_file" value="$(arg subject_file)"/>
    <param name="base_link" value="$(arg base_link)"/>
    <param name="ee_link"   value="$(arg ee_link)"/>
    <param name="base_frame" value="$(arg base_link)"/>
    <param name="human_joint_state_topic"  value="$(arg human_joint_state_topic)"/>
    <param name="human_link_lengths_topic" value="$(arg human_link_lengths_topic)"/>
    <param name="human_arm_points_topic"   value="$(arg human_arm_points_topic)"/>
    <param name="human_points_frame"       value="$(arg human_points_frame)"/>
    <param name="human_shoulder_frame"     value="$(arg human_shoulder_frame)"/>
    <param name="jacobian_source"          value="$(arg jacobian_source)"/>
    <param name="robot_jacobian_topic"     value="$(arg robot_jacobian_topic)"/>
    <rosparam param="path_center" subst_value="true">$(arg path_center)</rosparam>
    <param name="path_radius" value="$(arg path_radius)"/>
    <rosparam param="path_normal" subst_value="true">$(arg path_normal)</rosparam>
    <param name="path_direction" value="$(arg path_direction)"/>
    <param name="Ka" value="$(arg Ka)"/>
    <param name="rho_min" value="$(arg rho_min)"/>
    <param name="cruise_speed" value="$(arg cruise_speed)"/>
    <param name="follower_mode" value="$(arg follower_mode)"/>
    <param name="trial_laps" value="$(arg trial_laps)"/>
    <param name="require_fresh_human" value="$(arg require_fresh_human)"/>
    <param name="trial_label" value="$(arg trial_label)"/>
    <param name="csv_dir" value="$(eval csv_dir if str(csv).lower() == 'true' else '')"/>
    <param name="csv_path" value="$(arg csv_path)"/>
    <param name="v_max" value="$(arg v_max)"/>
    <param name="lpf_alpha" value="$(arg lpf_alpha)"/>
    <rosparam param="admittance_mass" subst_value="true">$(arg admittance_mass)</rosparam>
    <rosparam param="admittance_damping" subst_value="true">$(arg admittance_damping)</rosparam>
    <param name="force_deadzone_N" value="$(arg force_deadzone_N)"/>
    <param name="rate_hz" value="$(arg rate_hz)"/>
  </node>

  <!-- ================= visualization ================= -->
  <node pkg="sc_ros_empathic" type="rviz_visualization_node.py"
        name="sc_ros_empathic_viz" output="screen">
    <param name="base_frame" value="$(arg base_link)"/>
    <rosparam param="path_center" subst_value="true">$(arg path_center)</rosparam>
    <param name="path_radius" value="$(arg path_radius)"/>
    <rosparam param="path_normal" subst_value="true">$(arg path_normal)</rosparam>
    <param name="show_plane" value="$(arg show_plane)"/>
    <param name="show_vel_arrows" value="$(arg show_vel_arrows)"/>
    <param name="show_eta_text"   value="$(arg show_eta_text)"/>
    <param name="vel_arrow_gain"  value="$(arg vel_arrow_gain)"/>
    <param name="show_arm"        value="$(arg show_arm)"/>
    <param name="show_arm_fk"     value="$(arg show_arm_fk)"/>
    <param name="human_arm_source"   value="$(arg human_arm_source)"/>
    <param name="human_arm_topic"    value="$(arg human_arm_topic)"/>
    <param name="human_arm_msg_type" value="$(arg human_arm_msg_type)"/>
    <rosparam param="human_arm_keys"   subst_value="true">$(arg human_arm_keys)</rosparam>
    <rosparam param="human_arm_frames" subst_value="true">$(arg human_arm_frames)</rosparam>
    <param name="sc_node" value="/shared_control_node"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(arg rviz_config)"/>

  <!-- ================= trial recording ================= -->
  <!-- OFF by default; record:=true starts it. Everything the offline
       Sec. V-D metric analysis needs: the raw robot/human inputs and
       every ~diag/* observable. '-o' -> the bag is named
       <trial_label>_<YYYY-MM-DD-HH-MM-SS>.bag, so re-runs never
       overwrite. One bag per session; slice trials offline by the
       path_progress lap index (lap 0 = training). -->
  <node if="$(arg record)" pkg="rosbag" type="record" name="trial_recorder"
        output="screen"
        args="-o $(arg bag_dir)/$(arg trial_label)
              /franka_state_controller/franka_states
              $(arg human_joint_state_topic)
              $(arg human_link_lengths_topic)
              $(arg human_arm_points_topic)
              $(arg robot_jacobian_topic)
              /robot_vel_ctrl/vel_cmd
              /shared_control_node/eta
              /shared_control_node/diag/condition
              /shared_control_node/diag/factors_layout
              /shared_control_node/diag/factors_h
              /shared_control_node/diag/factors_r
              /shared_control_node/diag/v_h
              /shared_control_node/diag/v_r
              /shared_control_node/diag/v_s
              /shared_control_node/diag/force
              /shared_control_node/diag/joint_margins
              /shared_control_node/diag/manipulability
              /shared_control_node/diag/path_progress
              /shared_control_node/diag/arm_points
              /shared_control_node/diag/arm_points_fk
              /shared_control_node/diag/arm_points_layout"/>

</launch>
